# ORA RTL development environment (SpinalHDL + Verilator 5 + sbt)
#
# Build:  podman build -t ora-rtl -f Containerfile .
# Shell:  podman run --rm -it -v "$PWD":/work:Z localhost/ora-rtl
#
# Base is Ubuntu 24.04 (noble), whose apt ships Verilator 5.x (SpinalHDL 1.10
# requires >= 4.2xx). The JDK layer comes from Temurin.

FROM docker.io/eclipse-temurin:21-jdk-noble

# Verilator 5.x, C++ toolchain (SpinalSim compiles generated C++), and utilities
RUN apt-get update && apt-get install -y \
        verilator \
        g++ \
        gcc \
        make \
        perl \
        git \
        curl \
        ca-certificates \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && verilator --version

# sbt launcher
RUN curl -fsSL https://github.com/sbt/sbt/releases/download/v1.10.7/sbt-1.10.7.tgz \
        -o /tmp/sbt.tgz \
    && tar -xzf /tmp/sbt.tgz -C /opt \
    && rm /tmp/sbt.tgz \
    && ln -s /opt/sbt/bin/sbt /usr/local/bin/sbt

WORKDIR /work

# Warm the ivy/coursier caches with SpinalHDL deps (kept in an image layer)
COPY build.sbt /work/build.sbt
COPY project/build.properties /work/project/build.properties
RUN sbt -batch update

CMD ["/bin/bash"]
